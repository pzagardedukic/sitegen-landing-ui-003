  "services": {
    "text": "Three kinds of visit, from an opening movement assessment to a one-to-one session built around you. Scope, length, and price are agreed up front.",
    "items": [
      {
        "title": "Movement assessment",
        "text": "A sixty-minute review of posture, mobility, and breathing that produces a written training plan.",
        "features": [
          "Posture and mobility review",
          "Breathing pattern test",
          "Written plan for the first six weeks",
          "Group or one-to-one recommendation"
        ],
        "image": {
          "id": "service-interior",
          "file": "/images/storitev-analiza.webp"
        }
      },
      {
        "title": "Group reformer sessions",
        "text": "Fifty-five minutes in a group of up to eight, at three levels of difficulty, seven days a week.",
        "features": [
          "Eight people per session at most",
          "Three difficulty levels",
          "Booking up to two hours before",
          "Free cancellation 12 hours ahead"
        ],
        "image": {
          "id": "service-custom",
          "file": "/images/storitev-skupinske.webp"
        }
      },
      {
        "title": "One-to-one sessions",
        "text": "A session built around one body — for rehabilitation, pre-season preparation, or starting without a group.",
        "features": [
          "A programme made to measure",
          "Coordination with your physiotherapist",
          "Progress recorded at every visit",
          "Option to train in pairs"
        ],
        "image": {
          "id": "service-lighting",
          "file": "/images/storitev-individualno.webp"
        }
      }
    ]
  },
