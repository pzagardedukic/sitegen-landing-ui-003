  "careers": {
    "text": "We are looking for instructors who can read the body in front of them and adapt an exercise, rather than run a programme off a schedule.",
    "items": [
      {
        "title": "Reformer Pilates instructor",
        "text": "Leading group reformer sessions and one-to-one work. You would join a team that plans programmes together and reviews corrections at monthly supervisions.",
        "requirements": [
          "An international certification (BASI, Polestar, Merrithew, or equivalent)",
          "At least two years of leading groups",
          "Slovenian and English",
          "Willingness to work morning and evening slots"
        ],
        "note": "Full or part time, by agreement."
      },
      {
        "title": "Rehabilitation programme instructor",
        "text": "Working with members after injury and surgery, in close cooperation with physiotherapists. Mostly one-to-one and pairs.",
        "requirements": [
          "A degree in kinesiology or physiotherapy",
          "A rehabilitation Pilates certification",
          "Experience after knee and spinal surgery",
          "Careful record-keeping of progress"
        ],
        "note": "Part time, with room to grow."
      },
      {
        "title": "Front desk and membership lead",
        "text": "The first point of contact for members, handling bookings and memberships, and keeping the timetable accurate.",
        "requirements": [
          "Experience working with customers",
          "Care when working with data",
          "Slovenian and English",
          "Shift work, including Saturdays"
        ],
        "note": "Full time."
      }
    ]
  },
  "faq": {
    "text": "The questions we hear most before a first visit. If yours is not here, write to us — we answer the same day.",
    "items": [
      {
        "question": "Do I need previous Pilates experience?",
        "answer": "No. Every new member starts with a movement assessment, and we place you in the right group based on it. Beginner groups are closed and run for eight weeks."
      },
      {
        "question": "How often should I train?",
        "answer": "Twice a week is the line below which a change in posture rarely shows. Once a week maintains, three times speeds things up, and more than that adds little for most people."
      },
      {
        "question": "What do I need for my first visit?",
        "answer": "Comfortable clothes and grip socks, which you can also buy here. Everything else is in the studio. Come ten minutes early to fill in the health questionnaire."
      },
      {
        "question": "Can I train during pregnancy?",
        "answer": "Yes, in the dedicated prenatal group and after speaking with your gynaecologist. The programme follows the trimester; we do not usually enrol complete beginners in the first trimester."
      },
      {
        "question": "How do I cancel a booked session?",
        "answer": "Through the online calendar up to twelve hours before the start, at no cost. Cancel later and the session is deducted from your membership or pack."
      },
      {
        "question": "Can I freeze my membership?",
        "answer": "Once a year, for up to two months, in case of illness or a longer absence. Tell us before the end of the month, otherwise the membership renews."
      },
      {
        "question": "Do you work with physiotherapists?",
        "answer": "Yes. If you are under treatment we agree the load with your therapist and send progress notes when needed. We do not start a post-operative programme without their view."
      }
    ]
  },
