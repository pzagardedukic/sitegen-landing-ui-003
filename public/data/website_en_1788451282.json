      },
      {
        "title": "Back after knee surgery without the fear",
        "text": "My physiotherapist sent me here and it was the right continuation. Luka added resistance each week in agreement with the therapist, never in a hurry. Four months on, I am running again.",
        "url": "https://example.com/reviews/2",
        "image": {
          "id": "review-2",
          "file": "/images/mnenje-02.webp"
