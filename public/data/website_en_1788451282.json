  "about": {
    "aboutType": "ABOUT_COMPANY",
    "sectionName": "About the studio",
    "text": "Reforma is a Pilates studio with eight reformers and a dedicated mat space. We work in groups of up to eight, because that is the only way an instructor can see everyone and adjust an exercise as it happens. Every new member starts with a posture and movement assessment.",
    "establishedYear": 2017,
    "items": [
      {
        "text": "Every member starts with an assessment: posture, hip and shoulder mobility, and breathing. That produces a plan we review and adjust after six weeks.",
        "image": {
          "id": "about-materials",
          "file": "/images/onas-analiza.webp"
        }
      },
      {
        "text": "Our equipment is Balanced Body and Merrithew, serviced twice a year. Springs are replaced by hours of use rather than by looks, because resistance fades well before it shows.",
        "image": {
          "id": "about-systems",
          "file": "/images/onas-oprema.webp"
        }
      },
      {
        "text": "Groups are small on purpose. Eight reformers means eight people, even when we could take more — in Pilates a correction matters more than a repetition.",
        "image": {
          "id": "about-service",
          "file": "/images/onas-skupina.webp"
        }
      }
    ]
  },
